APP_NAME="Agenda Contábil"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Locale da interface (pt-BR). O código permanece em inglês.
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# Timestamps são persistidos em UTC e apresentados em America/Sao_Paulo.
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL é o banco canônico do projeto (RNF-003).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=agenda_contabil
DB_USERNAME=agenda
DB_PASSWORD=agenda
# Em produção (Amazon RDS): DB_SSLMODE=verify-full e DB_SSLROOTCERT com o
# pacote de certificados do RDS. Veja deploy/aws/env.production.example.
DB_SSLMODE=prefer
DB_SSLROOTCERT=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_EXPIRE_ON_CLOSE=true
# Em produção (HTTPS): SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@agenda.local"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TIMEOUT=10
# Lembretes por e-mail aos atendidos. Em produção ficam desligados até haver
# um serviço de e-mail aprovado.
MAIL_REMINDERS_ENABLED=true
# Redireciona todas as mensagens para uma caixa de teste.
MAIL_ALWAYS_TO=

# API do app (mobile/API.md): validade do token em minutos e origens que
# podem chamá-la de outro endereço (apps nativos e o PWA em desenvolvimento).
SANCTUM_EXPIRATION=720
CORS_ALLOWED_ORIGINS=https://localhost,capacitor://localhost,http://localhost:8080

VITE_APP_NAME="${APP_NAME}"

FORMS_ENABLED=false
FORMS_WEBHOOK_SECRET=
FORMS_ALLOWED_HOSTS=
FORMS_CREATE_URL=
