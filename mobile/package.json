{
    "name": "agenda-contabil-mobile",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "python3 -m http.server 8080",
        "test": "node --test tests/*.test.js",
        "build": "node scripts/build.mjs",
        "sync": "npm run build && cap sync",
        "android": "npm run sync && cap open android",
        "ios": "npm run sync && cap open ios",
        "test:layout": "playwright test",
        "build:demo": "node scripts/build.mjs --demo",
        "build:server": "node scripts/build.mjs --server",
        "sync:server": "npm run build:server && cap sync"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.3",
        "@capacitor/core": "^8.5.3",
        "@capacitor/filesystem": "^8.1.5",
        "@capacitor/ios": "^8.5.3",
        "@capacitor/share": "^8.0.3"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.5.3",
        "@playwright/test": "^1.64.1"
    },
    "overrides": {
        "xcode": {
            "uuid": "^11.1.1"
        },
        "glob": "^14.0.3",
        "minimatch": "^11.0.3"
    }
}
