# Production .env for the EC2 server. provision.sh copies it to
# /var/www/caderneta-sef/shared/.env (owner caderneta, group www-data, 640);
# database-setup.sh fills in the database password. Never commit the real one.

APP_NAME="CadernetaSEF"
APP_ENV=production
APP_DEBUG=false
# Generated once by provision.sh. It also encrypts CPF/CNPJ, notes and form
# links in the database: losing or replacing it makes them unreadable. Keep
# a copy in a password manager. To rotate, move the old value to
# APP_PREVIOUS_KEYS and follow docs/operations.md.
APP_KEY=
APP_PREVIOUS_KEYS=
APP_URL=https://agenda.example.org

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=America/Sao_Paulo
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Daily files in shared/storage/logs, removed after LOG_DAILY_DAYS.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Amazon RDS, private, reached from the EC2 only, always over TLS with the
# certificate checked against the RDS CA bundle.
DB_CONNECTION=pgsql
DB_HOST=caderneta-sef-db.XXXXXXXXXXXX.sa-east-1.rds.amazonaws.com
DB_PORT=5432
DB_DATABASE=caderneta_sef
DB_USERNAME=agenda_app
DB_PASSWORD=
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/ssl/certs/rds-global-bundle.pem

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_EXPIRE_ON_CLOSE=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Until a real mail service is approved, nothing leaves the server and
# nothing is written to the logs: "array" discards every message. Staff
# passwords are reset with "php artisan users:password <e-mail>".
MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="nao-responda@agenda.example.org"
MAIL_FROM_NAME="${APP_NAME}"
# Reminders to clients stay off until the project approves writing to them.
MAIL_REMINDERS_ENABLED=false
# While testing a mail service, every message goes to this inbox instead.
MAIL_ALWAYS_TO=

# Mobile API: tokens live one work shift; only the native apps call from
# another origin (the PWA under /app is on this same host).
SANCTUM_EXPIRATION=720
CORS_ALLOWED_ORIGINS=https://localhost,capacitor://localhost

FORMS_ENABLED=false
FORMS_WEBHOOK_SECRET=
FORMS_ALLOWED_HOSTS=
FORMS_CREATE_URL=

# Google Calendar (docs/google-calendar.md): an OAuth "Web application"
# client whose redirect URI is APP_URL/google/retorno. Empty, the option to
# connect a Google account is not shown.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
